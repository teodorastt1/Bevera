@model Bevera.Models.ViewModels.Supply.PurchaseOrderDetailsVm
@{
    Layout = null;
    var totalUnits = Model.Items.Sum(x => x.Quantity);
}
<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <title>Фактура по заявка #@Model.Id</title>
    <style>
        body{font-family:Arial,Helvetica,sans-serif;margin:32px;color:#1f2937;}
        h1,h2,h3,p{margin:0 0 10px;}
        .top{display:flex;justify-content:space-between;gap:20px;margin-bottom:30px;}
        .box{border:1px solid #d9e1ea;border-radius:14px;padding:16px;}
        table{width:100%;border-collapse:collapse;margin-top:16px;}
        th,td{border:1px solid #d9e1ea;padding:10px;text-align:left;}
        th{background:#f8fafc;}
        .right{text-align:right;}
        .muted{color:#64748b;}
        .total{margin-top:18px;display:flex;justify-content:flex-end;}
        .total .box{min-width:280px;}
        @@media print { .no-print { display:none; } body { margin: 12px; } }
    </style>
</head>
<body>
    <div class="top">
        <div>
            <h1>Bevera</h1>
            <p class="muted">Фактура за доставка / purchase order</p>
            <p>№ @Model.Id</p>
            <p>Дата: @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
        </div>
        <div class="box">
            <h3>Доставчик</h3>
            <p><strong>@Model.DistributorName</strong></p>
            <p>Статус: @Model.Status</p>
            <p>Изпратена: @(Model.SubmittedAt.HasValue ? Model.SubmittedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "—")</p>
            <p>Получена: @(Model.ReceivedAt.HasValue ? Model.ReceivedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "—")</p>
        </div>
    </div>

    <table>
        <thead>
            <tr><th>Продукт</th><th>Количество</th><th>Единична цена</th><th class="right">Общо</th></tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.DisplayQuantity</td>
                <td>@item.CostPrice.ToString("0.00") €</td>
                <td class="right">@item.LineTotal.ToString("0.00") €</td>
            </tr>
        }
        </tbody>
    </table>

    <div class="total">
        <div class="box">
            <p>Общо бройки: <strong>@totalUnits</strong></p>
            <p>Крайна сума: <strong>@Model.TotalAmount.ToString("0.00") €</strong></p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <div class="box" style="margin-top:18px;">
            <h3>Бележки</h3>
            <p>@Model.Notes</p>
        </div>
    }

    <p class="muted" style="margin-top:24px;">Тази фактура е част от вътрешната симулация на връзката между Bevera и дистрибутора.</p>
    <button class="no-print" onclick="window.print()">Принтирай</button>
</body>
</html>
