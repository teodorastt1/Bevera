@model List<Bevera.Models.Catalog.Product>

@{
    ViewData["Title"] = ViewBag.CategoryName ?? "Категория";

    var routeId = ViewContext.RouteData.Values["id"];
    var request = ViewContext.HttpContext.Request;
    var returnUrl = $"{request.Path}{request.QueryString}";

    string q = ViewBag.Q as string ?? "";
    decimal? minPrice = ViewBag.MinPrice as decimal?;
    decimal? maxPrice = ViewBag.MaxPrice as decimal?;
    bool onlyAvailable = ViewBag.OnlyAvailable != null && (bool)ViewBag.OnlyAvailable;
    bool onlyPromo = ViewBag.OnlyPromo != null && (bool)ViewBag.OnlyPromo;

    int? brandId = ViewBag.BrandId as int?;
    int? minMl = ViewBag.MinMl as int?;
    int? maxMl = ViewBag.MaxMl as int?;
    string packageType = ViewBag.PackageType as string ?? "";
    string sort = ViewBag.Sort as string ?? "";

    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;

    var brands = ViewBag.Brands as List<Bevera.Models.Catalog.Brand> ?? new();
    var packageTypes = ViewBag.PackageTypes as List<string> ?? new();
    var favIds = ViewBag.FavIds as List<int> ?? new List<int>();
}

<div class="category-page-wrap py-4 py-lg-5">
    <div class="container-fluid px-3 px-lg-4">

        <div class="category-hero mb-4 mb-lg-5">
            <h1 class="category-page-title mb-2">@ViewData["Title"]</h1>
            <div class="category-page-subtitle">
                Разгледай продуктите от категория „@ViewData["Title"]“.
                @if (totalItems > 0)
                {
                    <span> Намерени продукти: @totalItems</span>
                }
            </div>
        </div>

        <div class="row g-4">
            <aside class="col-12 col-xl-3">
                <div class="filter-box">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="filter-title">Филтри</div>

                        <a class="btn clear-filter-btn"
                           asp-controller="Client"
                           asp-action="Category"
                           asp-route-id="@routeId">
                            Изчисти
                        </a>
                    </div>

                    <form method="get"
                          asp-controller="Client"
                          asp-action="Category"
                          asp-route-id="@routeId">

                        <input type="hidden" name="page" value="1" />

                        <div class="mb-3">
                            <label class="form-label filter-label">Търси</label>
                            <input class="form-control filter-input" name="q" value="@q" placeholder="Напр. Coca Cola" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label filter-label">Цена (€)</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input class="form-control filter-input" type="number" step="0.01" min="0"
                                           name="minPrice" value="@(minPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" placeholder="От" />
                                </div>
                                <div class="col-6">
                                    <input class="form-control filter-input" type="number" step="0.01" min="0"
                                           name="maxPrice" value="@(maxPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" placeholder="До" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label filter-label">Марка</label>
                            <select class="form-select filter-input" name="brandId">
                                <option value="">Всички</option>
                                @foreach (var brand in brands)
                                {
                                    if (brandId == brand.Id)
                                    {
                                        <option value="@brand.Id" selected>@brand.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@brand.Id">@brand.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label filter-label">Милилитри</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input class="form-control filter-input" type="number" min="0" name="minMl" value="@(minMl?.ToString() ?? "")" placeholder="От мл" />
                                </div>
                                <div class="col-6">
                                    <input class="form-control filter-input" type="number" min="0" name="maxMl" value="@(maxMl?.ToString() ?? "")" placeholder="До мл" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label filter-label">Опаковка</label>
                            <select class="form-select filter-input" name="packageType">
                                <option value="">Всички</option>
                                @foreach (var type in packageTypes)
                                {
                                    if (packageType == type)
                                    {
                                        <option value="@type" selected>@type</option>
                                    }
                                    else
                                    {
                                        <option value="@type">@type</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label filter-label">Сортиране</label>
                            <select class="form-select filter-input" name="sort">
                                <option value="" selected="@(sort == "")">Име (А-Я)</option>
                                <option value="name_desc" selected="@(sort == "name_desc")">Име (Я-А)</option>
                                <option value="price_asc" selected="@(sort == "price_asc")">Цена ↑</option>
                                <option value="price_desc" selected="@(sort == "price_desc")">Цена ↓</option>
                                <option value="promo_desc" selected="@(sort == "promo_desc")">Най-голяма промоция</option>
                                <option value="ml_asc" selected="@(sort == "ml_asc")">Милилитри ↑</option>
                                <option value="ml_desc" selected="@(sort == "ml_desc")">Милилитри ↓</option>
                            </select>
                        </div>

                        <div class="form-check promo-check mb-2">
                            <input class="form-check-input" type="checkbox" name="onlyAvailable" value="true" checked="@onlyAvailable" />
                            <label class="form-check-label">Само налични</label>
                        </div>

                        <div class="form-check promo-check mb-3">
                            <input class="form-check-input" type="checkbox" name="onlyPromo" value="true" checked="@onlyPromo" />
                            <label class="form-check-label">Само промоции</label>
                        </div>

                        <button class="btn apply-filter-btn w-100" type="submit">Приложи</button>
                    </form>
                </div>
            </aside>

            <section class="col-12 col-xl-9">
                @if (Model == null || Model.Count == 0)
                {
                    <div class="alert empty-category-alert">Няма продукти по тези филтри.</div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var p in Model)
                        {
                            var img = p.Images?.FirstOrDefault(i => i.IsMain)?.ImagePath
                                      ?? p.Images?.FirstOrDefault()?.ImagePath
                                      ?? "/images/image-1.jpg";

                            var available = p.StockQty;
                            bool isFav = favIds.Contains(p.Id);

                            bool hasPromo = p.DiscountPercent.HasValue
                                            && p.DiscountPercent.Value > 0
                                            && (!p.DiscountEndsAt.HasValue || p.DiscountEndsAt.Value >= DateTime.UtcNow);

                            int realMl = 0;

                            if (p.Ml.HasValue && p.Ml.Value > 0)
                            {
                                realMl = p.Ml.Value;
                            }
                            else if (p.VolumeLiters > 0)
                            {
                                realMl = (int)decimal.Round(p.VolumeLiters * 1000m, 0);
                            }

                            string mlText = "—";

                            if (realMl >= 1000)
                            {
                                mlText = (realMl / 1000.0).ToString("0.#").Replace(".", ",") + " л";
                            }
                            else if (realMl > 0)
                            {
                                mlText = realMl + " мл";
                            }

                            <div class="col-12 col-sm-6 col-lg-4">
                                <div class="category-product-card">
                                    <a class="category-card-link"
                                       asp-controller="Client"
                                       asp-action="Product"
                                       asp-route-id="@p.Id">

                                        <div class="category-product-img-wrap">
                                            <img src="@img" alt="@p.Name" class="category-product-img" />

                                            @if (User.IsInRole("Client") && available > 0 && available < 10)
                                            {
                                                <span class="low-stock-badge">Ниска наличност</span>
                                            }

                                            @if (hasPromo)
                                            {
                                                <span class="promo-badge-small">-@p.DiscountPercent.Value.ToString("0")%</span>
                                            }
                                        </div>

                                        <div class="category-product-body">
                                            <div class="category-product-name">@p.Name</div>

                                            @if (p.Brand != null)
                                            {
                                                <div class="category-product-meta">@p.Brand.Name</div>
                                            }

                                            <div class="category-product-meta">
                                                @mlText
                                                @if (!string.IsNullOrWhiteSpace(p.PackageType))
                                                {
                                                    <span> • @p.PackageType</span>
                                                }
                                            </div>

                                            <div class="category-product-price">
                                                @if (hasPromo)
                                                {
                                                    <span class="old-price">@p.Price.ToString("0.00") €</span>
                                                    <span class="new-price">@p.EffectivePrice.ToString("0.00") €</span>
                                                }
                                                else
                                                {
                                                    <span class="regular-price">@p.Price.ToString("0.00") €</span>
                                                }
                                            </div>
                                        </div>
                                    </a>

                                    <div class="category-card-actions">
                                        @if (User.Identity?.IsAuthenticated == true)
                                        {
                                            <form asp-controller="Cart" asp-action="Add" method="post" class="flex-fill">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productId" value="@p.Id" />
                                                <input type="hidden" name="qty" value="1" />
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <button type="submit" class="btn buy-btn w-100">Купи</button>
                                            </form>

                                            <form asp-controller="Client" asp-action="ToggleFavorite" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productId" value="@p.Id" />
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <button type="submit" class="btn fav-btn @(isFav ? "active" : "")" title="Любими">
                                                    <i class="bi @(isFav ? "bi-heart-fill" : "bi-heart")"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <a class="btn buy-btn w-100 flex-fill"
                                               asp-area="Identity"
                                               asp-page="/Account/Login"
                                               asp-route-returnUrl="@returnUrl">
                                                Купи
                                            </a>

                                            <a class="btn fav-btn"
                                               asp-area="Identity"
                                               asp-page="/Account/Login"
                                               asp-route-returnUrl="@returnUrl"
                                               title="Любими">
                                                <i class="bi bi-heart"></i>
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (totalPages > 1)
                    {
                        <nav class="category-pagination-wrap mt-4 mt-lg-5">
                            <ul class="pagination category-pagination justify-content-center flex-wrap">

                                <li class="page-item @(page <= 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-controller="Client"
                                       asp-action="Category"
                                       asp-route-id="@routeId"
                                       asp-route-page="@(page - 1)"
                                       asp-route-q="@q"
                                       asp-route-minPrice="@minPrice"
                                       asp-route-maxPrice="@maxPrice"
                                       asp-route-onlyAvailable="@onlyAvailable"
                                       asp-route-onlyPromo="@onlyPromo"
                                       asp-route-brandId="@brandId"
                                       asp-route-minMl="@minMl"
                                       asp-route-maxMl="@maxMl"
                                       asp-route-packageType="@packageType"
                                       asp-route-sort="@sort">
                                        Назад
                                    </a>
                                </li>

                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    <li class="page-item @(i == page ? "active" : "")">
                                        <a class="page-link"
                                           asp-controller="Client"
                                           asp-action="Category"
                                           asp-route-id="@routeId"
                                           asp-route-page="@i"
                                           asp-route-q="@q"
                                           asp-route-minPrice="@minPrice"
                                           asp-route-maxPrice="@maxPrice"
                                           asp-route-onlyAvailable="@onlyAvailable"
                                           asp-route-onlyPromo="@onlyPromo"
                                           asp-route-brandId="@brandId"
                                           asp-route-minMl="@minMl"
                                           asp-route-maxMl="@maxMl"
                                           asp-route-packageType="@packageType"
                                           asp-route-sort="@sort">
                                            @i
                                        </a>
                                    </li>
                                }

                                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-controller="Client"
                                       asp-action="Category"
                                       asp-route-id="@routeId"
                                       asp-route-page="@(page + 1)"
                                       asp-route-q="@q"
                                       asp-route-minPrice="@minPrice"
                                       asp-route-maxPrice="@maxPrice"
                                       asp-route-onlyAvailable="@onlyAvailable"
                                       asp-route-onlyPromo="@onlyPromo"
                                       asp-route-brandId="@brandId"
                                       asp-route-minMl="@minMl"
                                       asp-route-maxMl="@maxMl"
                                       asp-route-packageType="@packageType"
                                       asp-route-sort="@sort">
                                        Напред
                                    </a>
                                </li>

                            </ul>
                            <div class="pagination-info text-center mt-2 text-muted small">
                                Страница <strong>@(page)</strong> от <strong>@(totalPages)</strong>
                            </div>
                        </nav>
                    }
                }
            </section>
        </div>
    </div>
</div>

<style>
    .category-page-wrap {
        background: linear-gradient(180deg, #fffdf9 0%, #fffaf4 40%, #fffefa 100%);
        min-height: 100vh;
    }

    .category-hero {
        background: linear-gradient(135deg, rgba(255,255,255,.88), rgba(255,248,239,.96));
        border: 1px solid rgba(230, 220, 210, .85);
        border-radius: 30px;
        padding: 28px 30px;
        box-shadow: 0 16px 40px rgba(76, 52, 32, .06);
    }

    .category-page-title {
        font-family: 'Playfair Display', serif;
        font-weight: 800;
        font-size: 3rem;
        color: #202431;
        line-height: 1.1;
        margin: 0;
    }

    .category-page-subtitle,
    .category-product-meta,
    .pagination-info {
        color: #7c8492;
    }

    .filter-box {
        background: linear-gradient(180deg, rgba(255,255,255,.88), rgba(255,250,244,.96));
        border: 1px solid rgba(230, 220, 210, .85);
        border-radius: 28px;
        padding: 22px;
        position: sticky;
        top: 92px;
        box-shadow: 0 16px 40px rgba(76, 52, 32, .06);
    }

    .filter-title {
        font-weight: 800;
        letter-spacing: .04em;
        text-transform: uppercase;
        font-size: .92rem;
        color: #222733;
    }

    .filter-label {
        font-size: .82rem;
        color: #7c8492;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .filter-input {
        border-radius: 16px;
        border: 1px solid rgba(226, 214, 203, .95);
        background: #fffdfa;
        min-height: 46px;
        box-shadow: none !important;
    }

    .filter-input:focus {
        border-color: rgba(245,179,1,.55);
        box-shadow: 0 0 0 .18rem rgba(245,179,1,.14) !important;
        background: #fff;
    }

    .promo-check .form-check-input:checked {
        background-color: #f5b301;
        border-color: #f5b301;
    }

    .apply-filter-btn,
    .buy-btn {
        background: linear-gradient(135deg, #1f2430, #2e3645);
        color: #fff;
        border: 0;
        border-radius: 999px;
        font-weight: 800;
    }

    .apply-filter-btn {
        padding: .85rem 1.2rem;
    }

    .buy-btn {
        padding: .78rem 1rem;
    }

    .apply-filter-btn:hover,
    .buy-btn:hover {
        background: linear-gradient(135deg, #161a23, #252d3a);
        color: #fff;
    }

    .clear-filter-btn {
        border-radius: 999px;
        border: 1px solid rgba(210, 200, 190, .95);
        background: #fff;
        color: #273040;
        font-weight: 700;
        padding: .45rem .9rem;
    }

    .clear-filter-btn:hover {
        background: #fff8ef;
        color: #1f2430;
    }

    .empty-category-alert {
        background: linear-gradient(180deg, rgba(255,255,255,.88), rgba(255,250,244,.96));
        border: 1px solid rgba(230, 220, 210, .85);
        border-radius: 24px;
        padding: 18px 20px;
        color: #5e6675;
        box-shadow: 0 16px 40px rgba(76, 52, 32, .06);
    }

    .category-product-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        background: #fff;
        border: 1px solid rgba(235, 225, 216, .95);
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 12px 30px rgba(40, 32, 24, .08);
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }

    .category-product-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 18px 36px rgba(40, 32, 24, .14);
        border-color: rgba(245,179,1,.35);
    }

    .category-card-link {
        display: block;
        text-decoration: none;
        color: inherit;
    }

    .category-product-img-wrap {
        height: 240px;
        background: linear-gradient(180deg, #fffdfa 0%, #fff7ee 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 18px;
        overflow: hidden;
        position: relative;
        border-bottom: 1px solid rgba(238,230,220,.75);
    }

    .category-product-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
        transition: transform .22s ease;
    }

    .category-product-card:hover .category-product-img {
        transform: scale(1.04);
    }

    .category-product-body {
        padding: 16px 16px 10px;
    }

    .category-product-name {
        color: #141821;
        font-size: 1rem;
        font-weight: 800;
        line-height: 1.45;
        min-height: 46px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .category-product-meta {
        font-size: .86rem;
        margin-top: 4px;
    }

    .category-product-price {
        margin-top: 10px;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .old-price {
        text-decoration: line-through;
        color: #8e8e8e;
        font-weight: 600;
    }

    .new-price {
        color: #AD0B16;
        font-weight: 900;
        font-size: 1.08rem;
    }

    .regular-price {
        color: #1d2431;
        font-weight: 900;
        font-size: 1.08rem;
    }

    .category-card-actions {
        padding: 0 16px 16px;
        display: flex;
        gap: 10px;
        margin-top: auto;
    }

    .fav-btn {
        min-width: 48px;
        height: 48px;
        border-radius: 999px;
        border: 1px solid rgba(220, 53, 69, .24);
        color: #dc3545;
        background: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .fav-btn:hover {
        background: #fff5f6;
        color: #c62839;
    }

    .fav-btn.active {
        background: #dc3545;
        color: #fff;
        border-color: #dc3545;
    }

    .low-stock-badge,
    .promo-badge-small {
        position: absolute;
        top: 12px;
        z-index: 2;
        padding: 7px 11px;
        font-size: .76rem;
        font-weight: 900;
        border-radius: 12px;
    }

    .low-stock-badge {
        left: 12px;
        background: linear-gradient(135deg, #ffc928, #f5b301);
        color: #111;
    }

    .promo-badge-small {
        right: 12px;
        background: linear-gradient(135deg, #cf1d2d, #a40f19);
        color: #fff;
    }

    .category-pagination {
        gap: 8px;
        margin-bottom: 10px;
    }

    .category-pagination .page-link {
        border: 1px solid rgba(230, 220, 210, .95);
        background: #fffdfa;
        color: #273040;
        border-radius: 999px;
        min-width: 44px;
        height: 44px;
        padding: 0 15px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
    }

    .category-pagination .page-link:hover {
        background: #fff3df;
        color: #1f2430;
    }

    .category-pagination .page-item.active .page-link {
        background: linear-gradient(135deg, #1f2430, #2e3645);
        border-color: #1f2430;
        color: #fff;
    }

    .category-pagination .page-item.disabled .page-link {
        opacity: .45;
        pointer-events: none;
    }

    @@media (max-width: 1199px) {
        .filter-box {
            position: static;
        }
    }

    @@media (max-width: 991px) {
        .category-page-title {
            font-size: 2.4rem;
        }

        .category-product-img-wrap {
            height: 220px;
        }
    }

    @@media (max-width: 575px) {
        .category-product-img-wrap {
            height: 210px;
        }

        .category-card-actions {
            gap: 8px;
        }
    }
</style>