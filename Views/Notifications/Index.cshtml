@model List<Bevera.Models.AppNotification>
@{
    Layout = null;
    ViewData["Title"] = "Нотификации";
}
<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bevera</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Bevera.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <div class="container py-4 py-lg-5">
        <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
            <div>
                <h2 class="mb-1" style="font-family:'Playfair Display',serif;">Нотификации</h2>
                <div class="text-muted small">Само списък с известия, без навигация и излишни елементи.</div>
            </div>

            <form asp-controller="Notifications" asp-action="MarkAllAsRead" method="post">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-secondary btn-sm">Маркирай всички като прочетени</button>
            </form>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="text-muted">Все още нямаш нотификации.</div>
        }
        else
        {
            <div class="list-group shadow-sm rounded-4 overflow-hidden">
                @foreach (var n in Model)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <div class="fw-semibold @(n.IsRead ? "text-muted" : "")">@n.Message</div>
                            <div class="small text-muted">@n.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                        </div>

                        @if (!n.IsRead)
                        {
                            <form asp-controller="Notifications" asp-action="MarkAsRead" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@n.Id" />
                                <button class="btn btn-sm btn-primary">Прочетено</button>
                            </form>
                        }
                    </div>
                }
            </div>
        }
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
