@using Microsoft.AspNetCore.Identity
@using Bevera.Data
@using Bevera.Models

@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Db

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var userId = UserManager.GetUserId(User);
    var userEmail = User.Identity?.Name ?? "Дистрибутор";

    var unreadCount = !string.IsNullOrWhiteSpace(userId)
        ? Db.AppNotifications.Count(x => x.UserId == userId && !x.IsRead)
        : 0;

    var previewDistributorId = Context.Request.Query["distributorId"].ToString();

    string RouteDistributorId()
    {
        return string.IsNullOrWhiteSpace(previewDistributorId) ? "" : previewDistributorId;
    }

    bool IsCurrent(string action)
    {
        return currentController == "Distributor" && currentAction == action;
    }
}

<!DOCTYPE html>
<html lang="bg">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Bevera</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

</head>

<body class="admin-body">

    <div class="admin-shell">

        <!-- SIDEBAR -->
        <aside class="admin-sidebar distributor-sidebar">

            <div class="admin-brand">
                Bevera
            </div>

            <div class="admin-sub">
                Дистрибутор
            </div>

            <nav class="admin-nav">

                <a asp-controller="Distributor"
                       asp-action="Index"
                       asp-route-distributorId="@RouteDistributorId()"
                       class="@(IsCurrent("Index") ? "active" : "")">
                    <span>🏠</span>
                    Табло
                </a>

                <a asp-controller="Distributor"
                       asp-action="Orders"
                       asp-route-distributorId="@RouteDistributorId()"
                       asp-route-tab="preparing"
                       class="@(IsCurrent("Orders") && (Context.Request.Query["tab"] == "preparing" || string.IsNullOrWhiteSpace(Context.Request.Query["tab"])) ? "active" : "")">
                    <span>🧾</span>
                    Заявки за подготовка
                </a>

                <a asp-controller="Distributor"
                       asp-action="Orders"
                       asp-route-distributorId="@RouteDistributorId()"
                       asp-route-tab="completed"
                       class="@(IsCurrent("Orders") && Context.Request.Query["tab"] == "completed" ? "active" : "")">
                    <span>✅</span>
                    Изпълнени заявки
                </a>

            </nav>

        </aside>


        <!-- MAIN CONTENT -->
        <main class="admin-main">

            <!-- TOPBAR -->
            <div class="admin-topbar">

                <div class="admin-title">
                    @ViewData["Title"]
                </div>

                <div class="admin-user d-flex align-items-center gap-3">

                    <div class="text-end">

                        <div class="small text-muted fw-bold">
                            Здравей, дистрибутор
                        </div>

                        <div class="fw-bold">
                            @userEmail
                        </div>

                    </div>

                    <!-- NOTIFICATIONS -->
                    <a asp-controller="Notifications"
                           asp-action="Index"
                           class="position-relative text-dark text-decoration-none"
                           title="Нотификации">

                        <i class="bi bi-bell" style="font-size:1.2rem;"></i>

                        @if (unreadCount > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                @unreadCount
                            </span>
                        }

                    </a>

                    <!-- LOGOUT -->
                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          method="post"
                          class="d-inline">

                        <button class="btn btn-sm btn-outline-secondary" type="submit">
                            Изход
                        </button>

                    </form>

                </div>

            </div>


            <!-- PAGE CONTENT -->
            <div class="admin-content">

                <div class="page-fade-in">@RenderBody()</div>

            </div>

        </main>

    </div>

    <partial name="_ToastNotifications" />

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/bevera-toast.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>